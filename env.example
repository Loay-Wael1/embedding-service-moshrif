EMBEDDING_MODEL_NAME=./model/bge-m3
EMBEDDING_MODEL_LOCAL_ONLY=true
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=8
EMBEDDING_ENABLE_SPARSE=true
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

QDRANT_PATH=./qdrant_db_legal
QDRANT_COLLECTION=egyptian_laws_v2_legal
INDEX_BATCH_SIZE=16
INDEX_INCLUDE_LAW_RECORDS=true

HF_ASSETS_REPO_ID=loaywael10/al-mostashar-legal-rag-assets
HF_ASSETS_REPO_TYPE=dataset
HF_ASSETS_REVISION=main
HF_ASSETS_DOWNLOAD_ENABLED=true

RETRIEVAL_TOP_K=5
RETRIEVAL_CHUNK_LIMIT=18
RETRIEVAL_ARTICLE_LIMIT=8
RETRIEVAL_LAW_LIMIT=3
RETRIEVAL_CANDIDATE_LIMIT=12
RETRIEVAL_EXCLUDE_NON_CURRENT=false
RETRIEVAL_RERANKER=feature_based
RETRIEVAL_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANKER_LOCAL_ONLY=false
RETRIEVAL_HYBRID_FUSION=rrf

# Groq-only LLM generation by default.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_NAME=groq
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK_PROVIDER_NAME=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1400
LLM_EXTRA_BODY_JSON=

# Gemini remains configurable, but is not required when running Groq-only.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

LEGAL_ANSWER_TOP_K=4
LEGAL_ANSWER_CONTEXT_CHAR_LIMIT=12000
LEGAL_ANSWER_SOURCE_CHAR_LIMIT=2400
LEGAL_ANSWER_GROUNDED_MIN_SOURCES=2
LEGAL_ANSWER_ASSISTED_MIN_SOURCES=1
LEGAL_ANSWER_GROUNDED_MIN_SCORE=0.62
LEGAL_ANSWER_ASSISTED_MIN_SCORE=0.28
LEGAL_ANSWER_GROUNDED_MIN_OVERLAP=0.16
LEGAL_ANSWER_ASSISTED_MIN_OVERLAP=0.07

# Server settings
API_HOST=0.0.0.0
API_PORT=7860

# Production settings
APP_ENV=production
LOG_LEVEL=info
DEBUG_RESPONSE_METADATA=false
ENABLE_PUBLIC_DOCS=false
CHAT_CONCISE_ANSWERS=true
CHAT_ANSWER_DETAIL_LEVEL=balanced
REQUIRE_INTERNAL_API_TOKEN=false
INTERNAL_API_TOKEN=
INTERNAL_API_TOKEN_HEADER=X-Internal-Service-Token
PROTECT_LEGAL_INFO=false
